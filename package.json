{
  "name": "tr-fuel-api",
  "version": "1.0.0",
  "description": "REST API for current fuel pump prices in Turkey (Petrol Ofisi, Shell)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.15",
    "@types/node": "^22.20.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkoca/tr-fuel-api.git"
  },
  "keywords": [],
